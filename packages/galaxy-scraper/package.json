{
  "name": "@repo/galaxy-scraper",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Scrapes Backgammon Galaxy blunder analysis into a local SQLite database",
  "bin": {
    "galaxy-scraper": "./src/cli.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./types": "./src/types.ts",
    "./config": "./src/config.ts",
    "./position": "./src/position.ts"
  },
  "scripts": {
    "sync": "node --disable-warning=ExperimentalWarning src/cli.ts sync",
    "login": "node --disable-warning=ExperimentalWarning src/cli.ts login",
    "categories": "node --disable-warning=ExperimentalWarning src/cli.ts categories",
    "scrape": "node --disable-warning=ExperimentalWarning src/cli.ts scrape",
    "load": "node --disable-warning=ExperimentalWarning src/cli.ts load",
    "reencode": "node --disable-warning=ExperimentalWarning src/cli.ts reencode",
    "all": "node --disable-warning=ExperimentalWarning src/cli.ts all",
    "stats": "node --disable-warning=ExperimentalWarning src/cli.ts stats",
    "check-types": "tsc --noEmit",
    "verify": "node --disable-warning=ExperimentalWarning src/cli.ts verify",
    "test": "node --disable-warning=ExperimentalWarning --test \"src/**/*.test.ts\""
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/node": "26.6.2",
    "typescript": "7.0.2"
  }
}
